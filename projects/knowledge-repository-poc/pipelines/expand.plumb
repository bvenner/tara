(* Expand the corpus from OpenAlex (bibliographic truth layer). *)
let expand_works : !{ mode: string, topic: string, limit: number, doi: string } -> !{ mode: string, matched: int, written: int, skipped: int } = exec {
  cmd: "../bin/tara-python",
  args: ["../scripts/expand_openalex.py"]
}

let main : !{ mode: string, topic: string, limit: number, doi: string } -> !{ mode: string, matched: int, written: int, skipped: int } = plumb(input, output) {
  spawn expand_works(input, output)
}